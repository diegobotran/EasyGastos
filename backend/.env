# Configuración del entorno para EasyGastos Backend

# Entorno (development, production)
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Base de datos MongoDB
MONGODB_URI=mongodb://localhost:27018/easygastos

# Configuración de CORS
# En desarrollo, puedes especificar IPs específicas
# En producción, se permitirán todas las conexiones
ALLOWED_ORIGINS=http://localhost:8081,http://192.168.1.100:8081

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# JWT Secret (cambiar en producción)
JWT_SECRET=tu_jwt_secret_super_seguro_aqui

# Configuración de archivos
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Configuración de red
# IP para bind del servidor (0.0.0.0 para todas las interfaces)
BIND_IP=0.0.0.0

# Configuración de logging
LOG_LEVEL=info

# SSL/TLS (para producción)
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=