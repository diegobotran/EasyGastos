{
  "name": "easygastos-backend",
  "version": "1.0.0",
  "description": "Backend API para EasyGastos - Sistema de gestión de gastos empresariales",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/contracts/fiscal-contracts.test.js test/contracts/sat-internal-contract.test.js test/models/mvp2-models.test.js test/migrations/mvp2-model-migration.test.js test/middleware/admin-auth.test.js test/catalogs/initial-catalogs.test.js test/catalogs/catalog-routes.test.js test/fiscal/fiscal-services.test.js",
    "test:contracts": "node --test test/contracts/fiscal-contracts.test.js test/contracts/sat-internal-contract.test.js",
    "grant-admin": "node scripts/grant-admin.js",
    "revoke-admin": "node scripts/revoke-admin.js",
    "migrate:mvp2-ep01:dry-run": "node scripts/migrate-mvp2-ep01-models.js --dry-run",
    "migrate:mvp2-ep01:apply": "node scripts/migrate-mvp2-ep01-models.js --apply",
    "migrate:catalogs:dry-run": "node scripts/migrate-initial-catalogs.js --dry-run",
    "migrate:catalogs:apply": "node scripts/migrate-initial-catalogs.js --apply",
    "init-db": "node scripts/init-database.js",
    "check-db": "node check-database.js",
    "create-sample-data": "node create-sample-data.js",
    "reset-db": "node scripts/reset-database.js",
    "import-sat": "node scripts/import-sat-facturas.js",
    "import-sat-clean": "node scripts/import-sat-facturas.js --clean"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "expenses",
    "api",
    "sqlite",
    "mobile",
    "enterprise"
  ],
  "author": "EasyGastos Team",
  "license": "MIT"
}
