# Configuración para el script de importación SAT

# URL del backend en AWS (NO incluir barra al final)
BACKEND_URL=http://23.20.116.61:3000

# Credenciales para autenticación
# IMPORTANTE: Debe ser un usuario existente en la app con email y PIN
SAT_EMAIL=admin@empresa.com
SAT_PIN=1234

# Carpeta local donde están los archivos Excel
# Puede ser ruta relativa o absoluta
SAT_FOLDER=./SAT

# Opcional: Configurar proxy si es necesario
# HTTP_PROXY=http://proxy.empresa.com:8080
# HTTPS_PROXY=http://proxy.empresa.com:8080
