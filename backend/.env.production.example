# Ejemplo de configuración para PRODUCCIÓN con PORT FORWARDING
# Copia este archivo como .env y modifica los valores según tu servidor

# IMPORTANTE: Cambiar NODE_ENV a production
NODE_ENV=production

# Puerto del servidor (debe coincidir con el port forwarding)
PORT=3000

# IP para bind del servidor (CRÍTICO: debe ser 0.0.0.0 para port forwarding)
BIND_IP=0.0.0.0

# Base de datos MongoDB (debe estar en localhost del servidor)
MONGODB_URI=mongodb://localhost:27017/easygastos

# CORS - En producción se permiten todas las conexiones automáticamente
# No cambiar esta configuración para port forwarding
ALLOWED_ORIGINS=*

# Rate limiting (valores más restrictivos para producción)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# JWT Secret (OBLIGATORIO: CAMBIAR POR UNO SEGURO)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_JWT_SECRET_MUY_SEGURO_EN_PRODUCCION

# Configuración de archivos
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Logging para producción
LOG_LEVEL=error

# SSL/TLS (opcional, para HTTPS futuro)
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# ================================================================
# CONFIGURACIÓN ESPECÍFICA PARA PORT FORWARDING
# ================================================================

# NOTAS IMPORTANTES PARA PORT FORWARDING:
# 
# 1. BIND_IP DEBE SER 0.0.0.0
#    - Esto permite que el servidor acepte conexiones desde cualquier IP
#    - Sin esto, el port forwarding NO funcionará
#
# 2. PORT debe coincidir con el port forwarding del router
#    - Router: IP_PUBLICA:3000 → SERVIDOR_INTERNO:3000
#    - Si cambias el puerto, actualiza también el router
#
# 3. FIREWALL del servidor debe permitir el puerto
#    - Ubuntu: sudo ufw allow 3000/tcp
#    - CentOS: sudo firewall-cmd --permanent --add-port=3000/tcp
#
# 4. La APP debe usar la IP PÚBLICA en config/backend.ts
#    - Obtén tu IP: curl ifconfig.me
#    - Actualiza: baseUrl: 'http://TU_IP_PUBLICA:3000'
#
# 5. TESTING:
#    - Local: curl http://localhost:3000/health
#    - Externo: curl http://TU_IP_PUBLICA:3000/health
#
# ================================================================

# PASOS DESPUÉS DE CONFIGURAR ESTE ARCHIVO:
# 1. Copiar como .env: cp .env.production.example .env
# 2. Editar .env con valores reales
# 3. Generar JWT_SECRET seguro
# 4. Reiniciar servidor: pm2 restart easygastos-backend
# 5. Verificar que escucha en 0.0.0.0: netstat -tuln | grep :3000
# 6. Configurar port forwarding en router
# 7. Probar acceso externo: curl http://TU_IP_PUBLICA:3000/health